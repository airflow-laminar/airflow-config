{
  "name": "airflow-config",
  "version": "1.12.4",
  "description": "Airflow utilities for configuration of many DAGs and DAG environments",
  "repository": "git@github.com:airflow-laminar/airflow-config.git",
  "author": "airflow-config <t.paine154@gmail.com>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "unpkg": "dist/cdn/index.js",
  "jsdelivr": "dist/cdn/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "types": "./dist/esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:debug": "node build.mjs --debug",
    "build:prod": "node build.mjs",
    "build:types": "tsc",
    "build": "npm-run-all build:prod build:types",
    "clean": "rm -rf dist playwright-report ../airflow_config/extension",
    "dev": "npm-run-all -p start watch",
    "lint": "oxlint . && oxfmt --check \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "fix": "oxlint --fix . && oxfmt --write \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "preinstall": "npx only-allow pnpm",
    "prepack": "npm run build",
    "test": "echo TODO",
    "watch": "nodemon --watch src -e ts,less --exec \"pnpm build:debug\""
  },
  "dependencies": {
    "@andypf/json-viewer": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "cpy": "^13.2.2",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  }
}
